{
  "_comment": "Scoreboard sidebar lines on Hypixel SkyBlock, matched against cleaned text (formatting and Hypixel's invisible marker characters removed). The title is matched with find(); every other pattern must match the whole line.",
  "title": "SK[YI]BLOCK",
  "title_guest": "GUEST\\s*$",
  "title_coop": "CO-OP\\s*$",
  "server_line": "(?<date>\\d{2}/\\d{2}/\\d{2})\\s+(?<server>\\S+)",
  "sky_date": "(?<month>(?:Early |Late )?(?:Spring|Summer|Autumn|Winter)) (?<day>\\d{1,2})(?:st|nd|rd|th)",
  "time": "(?<time>\\d{1,2}:\\d{2}\\s*(?:am|pm))\\s*(?<icon>\\S)?",
  "area": "(?<icon>[⏣ф])\\s*(?<area>.+)",
  "purse": "(?<kind>Purse|Piggy): (?<amount>[\\d,.]+)(?: \\((?<change>[+-][\\d,.]+)\\))?",
  "bits": "Bits: (?<amount>[\\d,.]+)(?: \\((?<change>[+-][\\d,.]+)\\))?",
  "motes": "Motes: (?<amount>[\\d,.]+)(?: \\((?<change>[+-][\\d,.]+)\\))?",
  "copper": "Copper: (?<amount>[\\d,.]+)(?: \\((?<change>[+-][\\d,.]+)\\))?",
  "north_stars": "North Stars: (?<amount>[\\d,.]+)",
  "objective_header": "Objective",
  "slayer_header": "Slayer Quest",
  "slayer_boss": "(?<boss>.+?) (?<tier>[IVX]+)",
  "slayer_progress": "\\(?(?<current>[\\d,.]+k?)/(?<needed>[\\d,.]+k?)\\)? (?<unit>Combat XP|Kills)",
  "slayer_fight": "Slay the boss!",
  "slayer_done": "Boss slain!",
  "dungeon_area": "The Catacombs \\((?<floor>[FM][1-7]|E)\\)",
  "dungeon_cleared": "Cleared: (?<percent>\\d{1,3})%(?: \\((?<score>\\d+)\\))?",
  "dungeon_time": "Time Elapsed: (?<time>.+)",
  "kuudra_area": "Kuudra's Hollow \\((?<tier>T[1-5])\\)",
  "website": "(?:www|alpha)\\.hypixel\\.net"
}
